# Umami-Tracking (optional). Kopiere diese Datei zu ".env" und trage deine Werte ein,
# oder setze die Variablen direkt in Netlify (Site settings → Environment variables).
# Ohne diese Werte wird KEIN Tracking-Script eingebunden.

PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
PUBLIC_UMAMI_WEBSITE_ID=
