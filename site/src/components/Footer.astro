---
import { PARTS, type PartId } from '../site';

interface Props {
  current?: PartId | 'home';
}
const { current } = Astro.props;

// Footer-Links: "Home" (außer auf der Startseite) + alle Teile außer dem aktuellen.
const links = [
  ...(current === 'home' ? [] : [{ href: '/', nav: 'Home' }]),
  ...PARTS.filter((p) => p.id !== current).map((p) => ({ href: p.href, nav: p.nav })),
];
---

<footer class="footer">
  <div class="wrap footer-in">
    <span>© 2026 Erleben gestalten</span>
    <nav aria-label="Fussnavigation">
      {links.map((l) => <a href={l.href}>{l.nav}</a>)}
    </nav>
  </div>
</footer>
