---
import { categoryColor, type Category } from '../lib/graph';

interface Props {
  url: string;
  title: string;
  summary: string;
  category: Category;
}
const { url, title, summary, category } = Astro.props;
const color = categoryColor[category];
---

<a class="card" href={url} style={`--accent:${color}`}>
  <span class="eyebrow cat">{category}</span>
  <h3 class="title">{title}</h3>
  <p class="summary">{summary}</p>
  <span class="go" aria-hidden="true">→</span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--ink);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: transform 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  /* Kraftlinie am oberen Rand — Kategoriefarbe als Signal */
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--accent);
    opacity: 0.85;
  }
  .card:hover { transform: translateY(-3px); border-color: var(--accent); }
  .cat { color: var(--accent); }
  .title { margin: 0; font-size: var(--text-xl); }
  .summary { margin: 0; color: var(--muted); font-size: var(--text-base); line-height: 1.55; }
  .go {
    font-family: var(--font-mono);
    color: var(--accent);
    align-self: flex-start;
    margin-top: var(--space-2);
    transition: transform 0.2s var(--ease);
  }
  .card:hover .go { transform: translateX(4px); }
</style>
