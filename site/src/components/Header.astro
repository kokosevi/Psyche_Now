---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const links = [
  { href: '/themen', label: 'Themen' },
  { href: '/graph', label: 'Graph' },
  { href: '/ueber', label: 'Über' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Psyche Now — Startseite">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">Psyche<span class="brand-now">Now</span></span>
    </a>
    <nav aria-label="Hauptnavigation">
      {links.map((l) => (
        <a href={l.href} class="nav-link" aria-current={isActive(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  body[data-field='true'] .site-header {
    background: color-mix(in srgb, var(--void) 78%, transparent);
    border-color: rgba(150, 140, 230, 0.18);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }
  /* Die Marke als kleines Kraftfeld: zwei Pole, eine Kante. */
  .brand-mark {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 35%, var(--node) 0 3px, transparent 4px),
      radial-gradient(circle at 72% 68%, var(--amber) 0 3px, transparent 4px),
      linear-gradient(120deg, var(--indigo) 0%, transparent 60%);
    border: 1px solid var(--line);
  }
  body[data-field='true'] .brand-mark { border-color: rgba(150, 140, 230, 0.3); }
  .brand-now { color: var(--amber); }
  nav { display: flex; gap: var(--space-6); }
  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--muted);
    padding: 6px 2px;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover { color: var(--ink); }
  body[data-field='true'] .nav-link:hover { color: var(--on-void); }
  .nav-link[aria-current='page'] { color: var(--ink); border-color: var(--amber); }
  body[data-field='true'] .nav-link[aria-current='page'] { color: var(--on-void); }

  @media (max-width: 520px) {
    nav { gap: var(--space-4); }
    .brand-name { display: none; }
  }
</style>
