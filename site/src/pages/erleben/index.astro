---
import Site from '../../layouts/Site.astro';
import GraphKonstellation from '../../components/graph/GraphKonstellation.astro';
import { buildGraph } from '../../lib/graph';
import { PARTS } from '../../site';

const part = PARTS.find((p) => p.id === 'erleben')!;
const graph = await buildGraph();
---
<Site title={part.label} current="erleben">
  <section class="pagehead pagehead-kompakt wrap">
    <h1>{part.label}</h1>
    <svg class="strich" viewBox="0 0 220 14" aria-hidden="true" focusable="false">
      <path d={part.strich} fill="none" stroke-width="4" stroke-linecap="round"></path>
    </svg>
  </section>
  <section class="wrap erleben-stage">
    <GraphKonstellation graph={graph} regionStyle="quadranten" />
  </section>
</Site>

<style>
  /* Flachere Karte wie auf /herausforderungen: möglichst viel ohne Scrollen sichtbar;
     schmale Viewports bleiben höher, damit die Knoten nicht gestaucht werden. */
  .erleben-stage :global(.konstellation) { aspect-ratio: 1.9; }
  @media (max-width: 720px) {
    .erleben-stage :global(.konstellation) { aspect-ratio: 1.1; }
  }

  /* Hover/Fokus auf einen Knoten hebt den verbundenen Teilgraph hervor,
     der Rest tritt zurück. Keine Drift-Animation. */
  /* Transform-Transition MUSS erhalten bleiben, sonst springt der gehoverte Knoten
     beim Vergrössern sofort (nur das Zurück-Verkleinern würde animieren). */
  .erleben-stage :global(.konstellation.dim .node) { opacity: .25; transition: opacity .2s var(--ease), transform .38s var(--ease); }
  .erleben-stage :global(.konstellation.dim .node.hot) { opacity: 1; }
  .erleben-stage :global(.konstellation.dim line) { stroke: var(--hairline); }
  .erleben-stage :global(.konstellation.dim line.hot) { stroke: var(--sun-deep); stroke-width: .9; }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('.erleben-stage .konstellation');
  if (wrap) {
    const nodes = Array.from(wrap.querySelectorAll<HTMLElement>('.node'));
    const lines = Array.from(wrap.querySelectorAll<SVGLineElement>('line'));
    const neighbors = new Map<string, Set<string>>();
    lines.forEach((l) => {
      const a = l.dataset.a!, b = l.dataset.b!;
      (neighbors.get(a) ?? neighbors.set(a, new Set()).get(a)!).add(b);
      (neighbors.get(b) ?? neighbors.set(b, new Set()).get(b)!).add(a);
    });

    const highlight = (slug: string | null) => {
      wrap.classList.toggle('dim', slug !== null);
      const hot = slug ? new Set([slug, ...(neighbors.get(slug) ?? [])]) : new Set<string>();
      nodes.forEach((n) => n.classList.toggle('hot', hot.has(n.dataset.slug!)));
      lines.forEach((l) => l.classList.toggle('hot', slug !== null && (l.dataset.a === slug || l.dataset.b === slug)));
    };
    nodes.forEach((n) => {
      n.addEventListener('mouseenter', () => highlight(n.dataset.slug!));
      n.addEventListener('focus', () => highlight(n.dataset.slug!));
      n.addEventListener('mouseleave', () => highlight(null));
      n.addEventListener('blur', () => highlight(null));
    });
  }
</script>
