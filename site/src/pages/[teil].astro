---
import Site from '../layouts/Site.astro';
import { PARTS } from '../site';

export function getStaticPaths() {
  return PARTS
    .filter((p) => p.id !== 'erleben' && p.id !== 'herausforderungen' && p.id !== 'psyche')
    .map((p) => ({ params: { teil: p.id }, props: { part: p } }));
}

const { part } = Astro.props;
---

<Site title={part.label} current={part.id}>
  <section class="pagehead wrap">
    <p class="overline">{part.overline}</p>
    <h1>{part.label}</h1>
    <svg class="strich" viewBox="0 0 220 14" aria-hidden="true" focusable="false">
      <path d={part.strich} fill="none" stroke-width="4" stroke-linecap="round"></path>
    </svg>
  </section>

  <section class="inhalt wrap">
    <img src={part.image} alt={part.alt} width="360" height="360" />
    <p>{part.intro}</p>
  </section>
</Site>

<style>
  .inhalt { text-align: center; padding: 24px 0 0; }
  .inhalt img { width: min(360px, 70vw); height: auto; }
  .inhalt p { max-width: 520px; margin: 24px auto 0; color: var(--ink-3); }
</style>
