---
import Site from '../layouts/Site.astro';
import { PARTS } from '../site';

// Landingpage «Netz» — Design-Referenz:
// design/handoffs/design_handoff_landingpage/landingpage.html (Geometrie 1:1).
// Icons: Feather «settings»/«zap», Lucide «brush» (MIT), inline als Pfad-Markup.
const ICONS: Record<string, string> = {
  psyche:
    '<circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>',
  herausforderungen:
    '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>',
  erleben:
    '<path d="m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08"></path><path d="M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z"></path>',
};

// Geometrie exakt aus der Vorlage: Zentren, Radien, Icon-Skalierung
// (Stroke lokal ≈ 4px / scale — ergibt überall die Kreisrand-Stärke),
// Label-Positionen (Herausforderungen oberhalb, Psyche/Erleben unterhalb).
const NODES = PARTS.map((p) => {
  const geo = {
    psyche: { cx: 190, cy: 430, r: 112, scale: 4.7, sw: 0.85, labelY: 578, subY: 608, float: 'schwebt-a' },
    herausforderungen: { cx: 430, cy: 190, r: 120, scale: 5.5, sw: 0.73, labelY: 28, subY: 60, float: 'schwebt-b' },
    erleben: { cx: 650, cy: 450, r: 116, scale: 4.9, sw: 0.82, labelY: 600, subY: 630, float: 'schwebt-a' },
  }[p.id];
  const [name, sub] = p.label.split(': ');
  return { ...geo, id: p.id, href: p.href, ariaLabel: `${p.overline} – ${p.label}`, name, sub, icon: ICONS[p.id] };
});
---

<Site title="Erleben gestalten – Home" current="home">
  <section class="held wrap">
    <div>
      <h1><em>Erleben</em> gestalten</h1>
      <p class="lead">Änderst du dein Erleben, ändert sich alles!</p>
    </div>
    <svg class="netz" viewBox="0 0 800 680" role="group" aria-label="Netz aus drei Themen-Knoten">
      <g class="kante" fill="none">
        <line x1="190" y1="430" x2="430" y2="190"></line>
        <line x1="430" y1="190" x2="650" y2="450"></line>
        <line x1="190" y1="430" x2="650" y2="450"></line>
      </g>
      {NODES.map((n) => (
        <g class={n.float}>
          <a class="knoten" href={n.href} aria-label={n.ariaLabel}>
            <circle class="kern" cx={n.cx} cy={n.cy} r={n.r}></circle>
            <g
              aria-hidden="true"
              transform={`translate(${n.cx},${n.cy}) scale(${n.scale}) translate(-12,-12)`}
              fill="none"
              stroke="#1E1D1D"
              stroke-width={n.sw}
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={n.icon}
            />
            <text x={n.cx} y={n.labelY} text-anchor="middle">{n.name}</text>{' '}
            <text class="sub" x={n.cx} y={n.subY} text-anchor="middle">{n.sub}</text>
          </a>
        </g>
      ))}
    </svg>
  </section>
</Site>

<style>
  .held {
    display: grid;
    grid-template-columns: minmax(300px, 5fr) 7fr;
    gap: 40px;
    align-items: center;
    min-height: calc(100svh - 73px);
    padding-bottom: 40px;
  }
  .held h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(46px, 6vw, 80px);
    line-height: 1.05;
    margin: 0;
    letter-spacing: -.01em;
    text-wrap: balance;
  }
  .held h1 em {
    font-style: normal;
    background: linear-gradient(transparent 62%, var(--sun) 62%, var(--sun) 96%, transparent 96%);
    padding: 0 4px;
  }
  .held .lead {
    margin: 24px 0 0;
    max-width: 44ch;
    font-family: var(--font-serif);
    font-size: 21px;
    font-style: italic;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* min-width: 0 — sonst bläht die automatische Grid-Item-Mindestbreite des SVGs
     die einspaltige Ansicht auf (horizontales Scrollen bei 390px). */
  .netz { width: 100%; height: auto; min-width: 0; }
  .netz .kante line { stroke: rgba(30, 29, 29, .22); stroke-width: 1.5; }
  .knoten { cursor: pointer; }
  .knoten circle.kern {
    fill: var(--sun);
    stroke: var(--ink);
    stroke-width: 4;
    transition: fill .18s ease;
  }
  .knoten:hover circle.kern { fill: var(--sun-deep); }
  .knoten text {
    font-family: var(--font-grotesk);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
    fill: var(--ink);
  }
  .knoten text.sub {
    font-size: 23px;
    letter-spacing: .06em;
    text-transform: none;
    fill: var(--ink-3);
  }

  .schwebt-a { animation: schweben 7s ease-in-out infinite; }
  .schwebt-b { animation: schweben 9s ease-in-out infinite reverse; }
  @keyframes schweben {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (max-width: 900px) {
    /* Abweichend von der Vorlage (padding: 48px 0): seitliches Padding beibehalten,
       sonst klebt der Text am Viewport-Rand (Prototyp-Bug, s. Screenshot-mobile). */
    .held { grid-template-columns: 1fr; min-height: 0; padding: 48px 28px; }
    .netz { max-width: 560px; margin: 0 auto; display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .schwebt-a, .schwebt-b { animation: none; }
    .knoten circle.kern { transition: none; }
  }
</style>
